# ═══════════════════════════════════════════
# ملف الإعدادات (Env Variables)
# قم بنسخ هذا الملف إلى ملف اسمه .env واملأ القيم
# ═══════════════════════════════════════════

# توكن بوت الزبونات (الذي يرد على الزبونات)
BOT_TOKEN=ضع_توكن_بوت_الزبونات_هنا

# توكن بوت الإدارة (الذي يضيف المنتجات)
ADMIN_BOT_TOKEN=ضع_توكن_بوت_الإدارة_هنا

# معرف المجموعة (التي تستقبل الطلبات)
ADMIN_CHAT_ID=ضع_معرف_المجموعة_هنا

# معرف القناة (التي ننشر فيها المنتجات)
CHANNEL_ID=ضع_معرف_القناة_هنا